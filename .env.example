POSTGRES_USER=tinylang
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=tiny_lang

JWT_SECRET=replace-with-at-least-64-random-characters
JWT_ISSUER=TinyLang.Backend
JWT_AUDIENCE=TinyLang.Frontend
JWT_ACCESS_TOKEN_EXP_MINUTES=15
JWT_REFRESH_TOKEN_EXP_MINUTES=10080
JWT_REFRESH_TOKEN_ROTATION_GRACE_SECONDS=10

RABBITMQ_USER=tinylang
RABBITMQ_PASSWORD=replace-with-a-long-random-password
RABBITMQ_VHOST=/tiny-lang

MINIO_ROOT_USER=tinylang
MINIO_ROOT_PASSWORD=replace-with-a-long-random-password
MINIO_BUCKET=tiny-lang
