{
  "Serilog": {
    "Using": ["Serilog.Sinks.Console", "Serilog.Sinks.File"],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/reports-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30
        }
      }
    ]
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DatabaseConnection": "",
    "RedisConnection": ""
  },
  "JwtSettings": {
    "JwtSecret": "",
    "Issuer": "TinyLang.Backend",
    "Audience": "TinyLang.Frontend",
    "AccessTokenExpMinutes": 15,
    "RefreshTokenExpMinutes": 10080
  },
  "EmailSettings": {
    "SmtpServer": "localhost",
    "SmtpPort": 1025,
    "SecureMode": "Auto",
    "SenderName": "TinyLang 的白鸽",
    "SenderEmail": "",
    "Username": "",
    "Password": ""
  },
  "RabbitMqSettings": {
    "Host": "localhost",
    "Port": 5672,
    "VirtualHost": "/tiny-lang",
    "Username": "",
    "Password": ""
  },
  "VerificationCodeSettings": {
    "CodeLength": 6,
    "ExpMinutes": 15
  },
  "ObjectStorageSettings": {
    "ServiceUrl": "http://localhost:9000",
    "Region": "us-east-1",
    "AccessKey": "",
    "SecretKey": "",
    "Bucket": "tiny-lang",
    "ForcePathStyle": true,
    "PublicBaseUrl": "http://localhost:9000/tiny-lang",
    "PresignedUrlExpirySeconds": 900
  },
  "UploadSettings": {
    "PictureMaxMB": 5,
    "AudioMaxMB": 20,
    "VideoMaxMB": 1024,
    "PictureAllowedTypes": {
      ".png": ["image/png"],
      ".jpg": ["image/jpeg"],
      ".jpeg": ["image/jpeg"],
      ".gif": ["image/gif"],
      ".webp": ["image/webp"]
    },
    "AudioAllowedTypes": {
      ".mp3": ["audio/mpeg"],
      ".wav": ["audio/wav", "audio/x-wav"],
      ".webm": ["audio/webm"],
      ".ogg": ["audio/ogg"]
    },
    "VideoAllowedTypes": {
      ".mp4": ["video/mp4"],
      ".webm": ["video/webm"],
      ".ogg": ["video/ogg"]
    }
  },
  "RateLimitSettings": {
    "StrictCodePermitLimit": 1,
    "StrictCodeWindowSeconds": 60,
    "UploadPresignTokenLimit": 5,
    "UploadPresignTokensPerPeriod": 5,
    "UploadPresignReplenishmentPeriodSeconds": 60,
    "GlobalFallbackPermitLimit": 200,
    "GlobalFallbackQueueLimit": 50
  }
}
